# Local laptop: SQLite file. Do not use this value on Vercel.
DATABASE_URL="file:./dev.db"

# Vercel (hobby) — Joel adds these on the project. Do not commit values.
# Vercel cannot use file: SQLite. When a CRM Postgres store is approved,
# set DATABASE_URL to that Neon / Vercel Postgres URL (postgresql://…), then Redeploy.
# Do not invent a password. Do not reuse a secret from chat.
# Do not paste a password or API key into chat.
# Missing RESEND_API_KEY = fail closed (no fake “email sent”, no account).
# After the first deploy, set CRM_PUBLIC_URL to the Vercel production URL.
RESEND_API_KEY=
CRM_MAIL_FROM=
CRM_PUBLIC_URL=
CRM_SESSION_SECRET=
DOCUSIGN_WEBHOOK_SECRET=

# Staff desk lock. Each person verifies their @nzcenergy.co.uk work email,
# then creates their own password. CRM_MAIL_FROM defaults to info@nzcenergy.co.uk
# if left blank. Do not invent other people’s addresses. Do not add a Cloudflare tunnel.

# Optional DocuSign (beyond the webhook secret). Leave blank to preview/download only.
DOCUSIGN_TEMPLATE_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_SIGNER_ROLE=Customer
DOCUSIGN_RETURN_URL=

# Optional local-only customer portal demo login.
# Never commit real values. Do not put customer names in these replacements.
PORTAL_DEMO_EMAIL=
PORTAL_DEMO_PASSWORD=
PORTAL_DEMO_TOKEN=
