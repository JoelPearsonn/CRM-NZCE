DATABASE_URL="file:./dev.db"

# Staff desk lock. If CRM_STAFF_PASSWORD is unset, exports/writes stay 401.
# Do not put a default password in source. Do not expose this CRM on a public URL.
CRM_STAFF_PASSWORD=
CRM_SESSION_SECRET=

# Optional DocuSign. Leave blank to preview/download the filled LOA only.
DOCUSIGN_TEMPLATE_ID=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_ACCESS_TOKEN=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi
DOCUSIGN_AUTH_SERVER=account-d.docusign.com
DOCUSIGN_SIGNER_ROLE=Customer
DOCUSIGN_RETURN_URL=
# Required to accept Connect webhooks. Missing secret = reject (fail closed).
DOCUSIGN_WEBHOOK_SECRET=

# Optional local-only customer portal demo login.
# Rotate any old demo passwords/tokens that were previously in source.
# Never commit real values. Do not put customer names in these replacements.
PORTAL_DEMO_EMAIL=
PORTAL_DEMO_PASSWORD=
PORTAL_DEMO_TOKEN=
